{
  "name": "worship-studio",
  "version": "0.8.33",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:remote": "vue-tsc -p tsconfig.remote.json --noEmit && vite build --config vite.remote.config.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "tauri": "tauri",
    "optimize:stock-backgrounds": "node scripts/optimize-stock-backgrounds.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdfmake": "^0.3.11",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.2.0",
    "vue3-moveable": "^0.28.0",
    "vuetify": "^4.1.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/webscreens-window-placement": "^0.1.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "medium-zoom": "^1.1.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
