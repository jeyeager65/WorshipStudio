{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Worship Studio",
  "version": "../package.json",
  "identifier": "dev.yeager.worshipstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm build:remote && pnpm docs:build && pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm build:remote && pnpm docs:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worship Studio",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Worship Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/stock-backgrounds/*"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOTZBMkFGMjNEMUNGRkMKUldUOHo5RWpyNktXclpUWkJXNVJWU1J0dStmRVAzSFpJSmY0WDJza20zeW0yOWpMMWxVMFlXR3QK",
      "endpoints": [
        "https://github.com/jeyeager65/WorshipStudio/releases/latest/download/latest.json"
      ]
    }
  }
}
