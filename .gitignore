node_modules/
.pnpm-store/
dist/
dist-ssr/
dist-remote/
# Combined static site assembled by scripts/build-pages.mjs (help site + app), built by the
# hosting provider rather than committed.
pages/
coverage/
*.local
*.tsbuildinfo

# Editor
.claude/
.vscode/*
!.vscode/extensions.json
.idea/

# Tauri
src-tauri/target/

# OS
.DS_Store
Thumbs.db

# Local-only media / synced library, once a real church folder is pointed at this checkout
.env

# Design handoff and OpenSong migration source — kept locally, not tracked in git
# (design/ is reference material from the planning conversation; OpenSong/ is ~278MB
# of real church data/media, too large and not appropriate for version control)
design/
OpenSong/

# Playwright MCP session output (console logs, page snapshots) — transient debugging
# artifacts, not project content
.playwright-mcp/

# Ad-hoc screenshots dropped at the repo root during manual/Playwright verification —
# root-only (leading slash) so it doesn't affect real image assets living in subdirectories
# like src/assets/ or src-tauri/icons/.
/*.png
/*.jpg
/*.jpeg

# Local MCP server config (e.g. Playwright, set up ad hoc for debugging) — a personal dev
# convenience, not a deliberate part of the project's testing toolchain (that's
# WebdriverIO + tauri-driver, see notes/architecture-plan.md). Revisit intentionally if we
# ever want this shared with every Claude Code session on the repo.
.mcp.json

# Windows code-signing private key (see notes/release-process.md) — the .pfx contains the
# private key and must never be committed; only the .cer (public certificate) is tracked.
scripts/release/*.pfx

# VitePress help site (docs/) build output/cache — see notes/help-system-plan.md. Build output
# goes straight to src-tauri/resources/help (docs/.vitepress/config.ts's outDir), not dist/.
docs/.vitepress/cache
src-tauri/resources/help/
